extends SceneTree
const Rules = preload("res://scripts/world.gd")
var failures := 0
func check(condition: bool, message: String) -> void:
 if not condition: failures += 1; push_error(message)
func _init() -> void:
 var w = Rules.new()
 w.save_path = "user://test-world.json"
 check(w.join(2,"alice","password-one") == "", "Create account")
 check(w.join(3,"bob","password-two") == "", "Create second account")
 check(w.join(4,"alice","password-one") != "", "Reject duplicate session")
 w.move(2,NAN,1,true)
 check(w.players[2].target.is_empty(), "Reject nonfinite movement")
 w.move(2,1000,1000,false); w.tick(0.1)
 check(Vector2(w.players[2].x,w.players[2].z-15).length() <= 0.61,"Movement bounded by server speed")
 w.action(2,"gather","0")
 check(w.players[2].inventory.get("wood",0) == 0,"Reject distant gathering")
 w.tick(1)
 w.move(2,0,0,false)
 w.players[2].x = -18; w.players[2].z = -12
 w.action(2,"gather","0")
 check(w.players[2].inventory.wood == 1,"Gather nearby node")
 w.action(2,"gather","0")
 check(w.players[2].inventory.wood == 1,"Gather cooldown enforced")
 for i in range(4): w.tick(1.1); w.action(2,"gather","0")
 check(w.resources[0].left == 0,"Resource depletion")
 w.tick(31)
 check(w.resources[0].left == 5,"Resource respawn")
 w.players[2].x=0; w.players[2].z=15; w.players[2].inventory={"wood":10,"stone":10,"scrap":2}
 w.action(2,"craft","axe")
 check(w.players[2].inventory.get("axe",0)==1 and w.players[2].inventory.wood==7,"Atomic crafting cost and output")
 w.tick(1); w.action(2,"sell","axe:10")
 check(w.players[2].inventory.get("axe",0)==0,"Escrow removes offered item")
 check(w.save()==OK,"Save succeeds")
 var disk = Rules.new(); disk.save_path=w.save_path; disk.load_save()
 check(disk.join(9,"alice","wrong-password") != "","Authentication persists")
 check(disk.join(9,"alice","password-one") == "","Resume account")
 check(disk.players[9].inventory.get("axe",0)==1,"Escrow refunded on server restart")
 w.action(3,"buy","2")
 check(w.players[3].inventory.get("axe",0)==1 and w.players[3].coins==15 and w.players[2].coins==35,"Trade transfers exactly once")
 w.tick(1); w.action(3,"buy","2")
 check(w.players[3].coins==15,"No replayed purchase")
 w.tick(1); w.action(2,"sell","wood:-10")
 check(not w.offers.has(2),"Reject negative prices")
 w.tick(1); w.action(2,"sell","wood:5"); w.leave(2)
 check(w.accounts.alice.inventory.wood==7,"Disconnect refunds escrow")
 w.players[3].inventory.spear=1
 w.action(3,"pvp","3")
 check(w.players[3].hp==100,"Cannot attack self / safe combat")
 check(not str(w.snapshot()).contains("password-two") and not w.snapshot().players[3].has("key"),"Credentials excluded from snapshots")
 w.tick(1)
 w.players[3].hp=100; w.players[3].x=0; w.players[3].z=-23
 w.drones[1].x=0; w.drones[1].z=-23
 w.action(3,"drone","1")
 check(w.drones[1].hp==30,"Spear damage in danger area")
 w.tick(1.1); w.action(3,"drone","1")
 w.tick(1.1); w.action(3,"drone","1")
 check(w.drones[1].hp<=0 and w.players[3].inventory.get("scrap",0)==3,"Drone kill loot")
 w.tick(26)
 check(w.drones[1].hp==45,"Drone respawn")
 w.players[3].hp=0; w.tick(0.1)
 check(w.players[3].hp==100 and w.players[3].z==15,"Death rescue")
 check(w.save()==OK,"Save world after activity")
 var reload_world=Rules.new(); reload_world.save_path=w.save_path; reload_world.load_save()
 check(reload_world.resources[0].left==w.resources[0].left,"Resource state persisted")
 DirAccess.remove_absolute(w.save_path)
 if failures==0: print("WORLD_TESTS_PASS")
 quit(0 if failures==0 else 1)
